# Copy to .env and fill in real values before running `docker compose up` in
# production. The dev compose file (docker-compose.dev.yml) does not need
# this — it uses hardcoded dev-only secrets.

# ─── Database / Cache ───────────────────────────────────────────────────
DB_PASSWORD=change-me
REDIS_PASSWORD=change-me

# ─── Backend secrets ─────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-a-different-long-random-string

# ─── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# ─── Ports ────────────────────────────────────────────────────────────────
BACKEND_PORT=5000
WEB_PORT=3000

# ─── Web frontend build-time config ──────────────────────────────────────
# Baked into the web-frontend bundle at build time (Vite resolves env vars
# during `vite build`, not at container runtime).
VITE_API_BASE_URL=http://localhost:5000/api/v1

# ─── Optional market-data providers (backend) ────────────────────────────
ALPHA_VANTAGE_API_KEY=
COINAPI_KEY=

# ─── Blockchain (optional; docker compose --profile blockchain up) ──────
# Everything below is only used when the `blockchain` compose profile is
# active (see docker-compose.yml). Without it, the backend's
# WEB3_PROVIDER_URI simply won't resolve and BlockchainService reports
# itself as disconnected - the rest of the app is unaffected either way.
#
# Explicit contract address overrides. Leave unset for local
# docker-compose use - the backend resolves deployed addresses
# automatically from the blockchain-migrate service's build artifacts
# instead. Set these when pointing at a real/shared deployment (a testnet
# or mainnet) rather than the local ganache instance.
DATA_TRACKING_CONTRACT_ADDRESS=
TREND_ANALYSIS_CONTRACT_ADDRESS=
QUANTUMVEST_TOKEN_CONTRACT_ADDRESS=
QUANTUMVEST_ORACLE_CONTRACT_ADDRESS=

# Private key of the DataTracking contract's owner account, only needed
# for write operations (POST /api/v1/blockchain/market-data). Leave unset
# to keep the blockchain integration read-only. Never put a real-funds key
# here outside a secrets manager.
BLOCKCHAIN_PRIVATE_KEY=
