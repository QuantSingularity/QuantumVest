# Copy to .env and fill in real values before running `docker compose up` in
# production. The dev compose file (docker-compose.dev.yml) does not need
# this — it uses hardcoded dev-only secrets.

# ─── Database / Cache ───────────────────────────────────────────────────
DB_PASSWORD=change-me
REDIS_PASSWORD=change-me

# ─── Backend secrets ─────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-a-different-long-random-string

# ─── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# ─── Ports ────────────────────────────────────────────────────────────────
BACKEND_PORT=5000
WEB_PORT=3000

# ─── Web frontend build-time config ──────────────────────────────────────
# Baked into the web-frontend bundle at build time (Vite resolves env vars
# during `vite build`, not at container runtime).
VITE_API_BASE_URL=http://localhost:5000/api/v1

# ─── Optional market-data providers (backend) ────────────────────────────
ALPHA_VANTAGE_API_KEY=
COINAPI_KEY=
