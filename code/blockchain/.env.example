# Copy this file to .env and fill in real values. Never commit the .env file.

# Wallet mnemonic used by HDWalletProvider to sign and pay for deployments
# to bsc_testnet. Required only for that network.
MNEMONIC=

# Optional: override the default BSC testnet RPC endpoint.
# BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# Optional: Chainlink AggregatorV3 price feed address for TrendAnalysis on
# whatever network you're deploying to. If unset on a network with no
# built-in default (see migrations/2_deploy_market_data_contracts.js), a
# local MockV3Aggregator is deployed instead.
# PRICE_FEED_ADDRESS=

# Optional: fee collector address for PortfolioManager. Defaults to the
# deploying account if unset.
# FEE_COLLECTOR_ADDRESS=

# Used by the `docker` network (see truffle-config.js), which
# docker-compose.yml's blockchain-migrate service deploys against. Not
# needed for local (non-Docker) development.
# GANACHE_HOST=ganache
# GANACHE_PORT=8545
