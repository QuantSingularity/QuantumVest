FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///quantumvest_dev.db
ALPHA_VANTAGE_API_KEY=
COINAPI_KEY=
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# ─── Blockchain (optional) ────────────────────────────────────────────────
# See app/services/blockchain.py. Everything below is optional; with no
# reachable provider the app runs fine with blockchain features disabled.
#
# For local (non-Docker) development: run `cd ../blockchain && npm install
# && npx ganache --port 8545 --chain.chainId 1337 --chain.networkId 1337`
# in one terminal, then `npx truffle migrate --network development` in
# another. The default BLOCKCHAIN_ARTIFACTS_DIR (../blockchain/build/
# contracts) will pick up the deployed addresses automatically.
BLOCKCHAIN_ENABLED=true
WEB3_PROVIDER_URI=http://localhost:8545
# BLOCKCHAIN_ARTIFACTS_DIR=../blockchain/build/contracts

# Explicit address overrides (take precedence over the build artifact
# lookup above). Needed for any network you haven't built contracts
# against locally, e.g. a shared testnet.
DATA_TRACKING_CONTRACT_ADDRESS=
TREND_ANALYSIS_CONTRACT_ADDRESS=
QUANTUMVEST_TOKEN_CONTRACT_ADDRESS=
QUANTUMVEST_ORACLE_CONTRACT_ADDRESS=

# Only needed for write operations (POST /api/v1/blockchain/market-data);
# must be the DataTracking contract owner's private key. Leave unset to
# keep the integration read-only.
BLOCKCHAIN_PRIVATE_KEY=
