# QuantumVest Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Application ──────────────────────────────────────────────────────────────
FLASK_ENV=production
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=quantumvestdb
DB_USER=appuser
DB_PASSWORD=CHANGE_ME_min16chars!!
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password!!

# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
API_KEY_HASH=CHANGE_ME_hash_of_api_key

# ── Redis ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 24
REDIS_PASSWORD=CHANGE_ME_redis_password

# ── Frontend ──────────────────────────────────────────────────────────────────
# web-frontend is a Vite app — only VITE_-prefixed vars are exposed to client
# code, and only at build time (see docker/Dockerfile.frontend). Must include
# the /v1 suffix: the backend's routes are registered under /api/v1/*.
VITE_API_BASE_URL=/api/v1

# ── Monitoring ────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_grafana_password
