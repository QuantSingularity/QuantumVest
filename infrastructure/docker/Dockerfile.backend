# syntax=docker/dockerfile:1
#
# Dockerfile for the QuantumVest backend (Flask + Gunicorn).
# Build context is the repository root (see docker-compose.yml: context: ..),
# so all COPY paths below are relative to the repo root, not this directory.

# ─── Builder ──────────────────────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build

# Build tools for packages with C extensions (numpy, scipy, scikit-learn,
# pandas, statsmodels, cryptography, bcrypt) — not needed in the final image.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY code/backend/requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# ─── Production ───────────────────────────────────────────────────────────
FROM python:3.11-slim AS production

# Runtime-only system dependency: PyMySQL uses pure-Python MySQL protocol
# code, so unlike mysqlclient it needs no libmysqlclient at all.
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1000 appuser \
    && useradd --uid 1000 --gid appuser --shell /bin/bash --create-home appuser

WORKDIR /app

# Bring in the packages built above (installed to the builder's user site-packages)
COPY --from=builder /root/.local /home/appuser/.local
COPY code/backend/ .

RUN chown -R appuser:appuser /app /home/appuser/.local

USER appuser
ENV PATH=/home/appuser/.local/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=40s \
    CMD wget -qO- http://localhost:8080/api/v1/health || exit 1

# wsgi.py defines `app = create_app(...)` — there is no main.py/app.py in
# this backend. Access/error logs go to stdout/stderr (`-`) rather than a
# file, since the container is intended to run with a read-only root
# filesystem (see docker-compose.yml: read_only: true).
CMD ["gunicorn", "wsgi:app", \
     "--bind", "0.0.0.0:8080", \
     "--workers", "4", \
     "--worker-class", "gthread", \
     "--threads", "2", \
     "--timeout", "60", \
     "--access-logfile", "-", \
     "--error-logfile", "-"]
