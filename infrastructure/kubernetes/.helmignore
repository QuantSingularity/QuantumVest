# Patterns to ignore when packaging or rendering the chart.
# The example secrets file is documentation only; rendering it would emit a
# second Secret with the same name as templates/app-secrets.yaml.
templates/app-secrets.example.yaml

# Per-environment overrides are passed with -f and are not part of the package.
environments/

# VCS and editor files
.git/
.gitignore
.DS_Store
*.swp
*.bak
*.tmp
*~
.idea/
.vscode/
